# Telegram bot token from @BotFather. Disable privacy mode (/setprivacy) so the bot sees all group messages.
BOT_TOKEN=

# Your Telegram user ID. Reserved for owner-only settings.
OWNER_ID=

# Comma-separated chat IDs the bot works in. Empty means every chat.
ALLOWED_GROUPS=

# Default model for chats without their own model.
# LLM_PROVIDER is one of: openai (any OpenAI-compatible API), openrouter, gemini.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Base64-encoded 32-byte key that encrypts stored provider API keys: openssl rand -base64 32
MASTER_KEY=

DB_PATH=data/messages.db
CACHE_SIZE=1000
HTTP_ADDR=:8080
LOG_LEVEL=info
