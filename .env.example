# Telegram bot token from @BotFather. Disable privacy mode (/setprivacy) so the bot sees all group messages.
BOT_TOKEN=

# Your Telegram user ID. The owner may share providers with every group,
# and only the owner's providers may point at local/private addresses (e.g. a local model server).
OWNER_ID=

# Comma-separated chat IDs the bot works in. Empty means every chat.
ALLOWED_GROUPS=

# Required. Base64-encoded 32-byte key that encrypts stored provider API keys: openssl rand -base64 32
MASTER_KEY=

DB_PATH=data/messages.db
CACHE_SIZE=1000
HTTP_ADDR=:8080
LOG_LEVEL=info
